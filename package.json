{
  "name": "@substrate-system/image-input",
  "type": "module",
  "version": "0.0.9",
  "main": "dist/index.js",
  "files": [
    "./dist/*"
  ],
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js}\"",
    "build-tests": "lightningcss --bundle --targets '>= 0.25%' src/index.css -o test/index.css && esbuild test/index.ts --target=es2020 --bundle --keep-names --loader:.css=text > test/test-bundle.js",
    "test": "npm run lint && npm run build && npm run build-tests && npm run test-tapout",
    "test-tapout": "cat test/test-bundle.js | tapout --timeout 60000 | tap-spec",
    "build-css": "lightningcss --bundle --targets '>= 0.25%' src/index.css -o dist/index.css",
    "build-css:min": "lightningcss --bundle --minify --targets '>= 0.25%' src/index.css -o dist/index.min.css",
    "build-cjs": "esbuild src/*.ts --format=cjs --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.cjs --sourcemap",
    "build-esm": "esbuild src/*.ts --format=esm --metafile=dist/meta.json --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.build.json --outDir dist",
    "build-esm:min": "esbuild ./src/*.ts --format=esm --keep-names --bundle --tsconfig=tsconfig.build.json --minify --out-extension:.js=.min.js --outdir=./dist --sourcemap",
    "build-example": "mkdir -p ./public && rm -rf ./public/* && NODE_ENV=development vite --mode development --base=\"/image-input\" build",
    "build-docs": "typedoc --tsconfig tsconfig.build.json ./src/index.ts",
    "build": "mkdir -p ./dist && rm -rf ./dist/* && npm run build-cjs && npm run build-esm && npm run build-esm:min && npm run build-css && npm run build-css:min",
    "start": "vite",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "preversion": "npm run lint && stylelint src/*.css",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/index.css",
    "./css/min": "./dist/index.min.css",
    "./*": {
      "import": [
        "./dist/*.js",
        "./dist/*"
      ],
      "require": [
        "./dist/*.cjs",
        "./dist/*"
      ]
    }
  },
  "dependencies": {
    "@substrate-system/drag-drop": "^0.4.12",
    "@substrate-system/web-component": "^0.0.56"
  },
  "devDependencies": {
    "@preact/signals": "^2.10.0",
    "@substrate-system/debug": "^0.9.67",
    "@substrate-system/dom": "^0.1.13",
    "@substrate-system/drag-drop": "^0.4.12",
    "@substrate-system/human-bytes": "^0.0.6",
    "@substrate-system/tapout": "^0.0.40",
    "@substrate-system/tapzero": "^0.10.16",
    "auto-changelog": "^2.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "htm": "^3.1.1",
    "lightningcss": "^1.33.0",
    "lightningcss-cli": "^1.33.0",
    "markdown-toc": "^1.2.0",
    "newneostandard": "^0.14.1",
    "preact": "^10.29.7",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tap-spec": "^5.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)"
}
